# Production settings. Copy to deploy/.env on the server and fill in. Never commit deploy/.env.

# ─── Address ───
# The domain (or subdomain) pointing at this server, without https://. Example: play.edilbingo.com
DOMAIN=
# Shown at the top of the game.
BRAND_NAME=Bingo

# ─── Secrets: make each one long and random ───
# Generate with:  openssl rand -hex 24
POSTGRES_PASSWORD=
# Generate with:  openssl rand -hex 32
JWT_SECRET=

# ─── Telegram ───
BOT_TOKEN=
BOT_USERNAME=
# Your Telegram id (and other staff), comma-separated. Do NOT include the test id 1 in production.
ADMIN_TELEGRAM_IDS=

# ─── Where players pay ───
TELEBIRR_ACCOUNT=
TELEBIRR_NAME=
CBE_BIRR_ACCOUNT=
CBE_BIRR_NAME=

# ─── Money (whole birr) ───
DEPOSIT_MIN_BIRR=100
WITHDRAW_MIN_BIRR=100
FIRST_DEPOSIT_BONUS_PERCENT=20
FIRST_DEPOSIT_BONUS_MAX_BIRR=200
REFERRAL_BONUS_BIRR=10
REFERRAL_MAX_FRIENDS=30
WELCOME_BONUS_BIRR=0

# ─── Game ───
# Fixes what is printed on every card. Do not change it after launch.
CARD_SET_SEED=bingo-cards-v1
RESULT_SECONDS=8
REQUIRE_PHONE=true
