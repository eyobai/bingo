NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:55432/bingo
# At least 32 random characters. Signs player sessions.
JWT_SECRET=change-me-to-a-long-random-string-123456
JWT_TTL=7d
# Comma-separated list of sites allowed to call the API (your Mini App address). Empty = any.
CORS_ORIGINS=

# ─── Telegram ───
# From @BotFather. Empty = bot off (and Telegram sign-in off).
BOT_TOKEN=
# Without the @. Used for invite links.
BOT_USERNAME=
# Public https address of the Mini App (the "Play" button opens it).
MINIAPP_URL=
# How old Telegram sign-in data may be, in seconds.
INIT_DATA_MAX_AGE_SECONDS=86400
# Telegram user ids (numbers) that become staff: they get deposit/withdrawal approval buttons in the bot.
ADMIN_TELEGRAM_IDS=
# Browser sign-in without Telegram, for development only. Refused when NODE_ENV=production.
DEV_LOGIN=false

# ─── Game ───
# Fixes what is printed on every card. Do not change it once players have seen the cards.
CARD_SET_SEED=bingo-cards-v1
# How long the winner screen stays before the next round.
RESULT_SECONDS=8
# Creates a "10 Birr Game" room on first start when there is none.
SEED_ROOMS=true

# ─── Money (whole birr) ───
DEPOSIT_MIN_BIRR=100
WITHDRAW_MIN_BIRR=100
FIRST_DEPOSIT_BONUS_PERCENT=20
FIRST_DEPOSIT_BONUS_MAX_BIRR=200
REFERRAL_BONUS_BIRR=10
WELCOME_BONUS_BIRR=0

# ─── Where players send deposits. Empty account = method hidden. ───
# The name must match the name in the payment SMS (checked word by word).
TELEBIRR_ACCOUNT=
TELEBIRR_NAME=
CBE_BIRR_ACCOUNT=
CBE_BIRR_NAME=
